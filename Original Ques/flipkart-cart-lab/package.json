{
  "name": "flipkart-cart-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:server": "node server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "db:inspect": "node scripts/db.js",
    "repro": "node scripts/repro.js",
    "reset": "node server/seed.js",
    "build": "vite build --config client/vite.config.js",
    "test": "npm run test:server && npm run test:client",
    "test:server": "node --test tests/server/*.test.js",
    "test:client": "vitest run --config client/vite.config.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.5.0",
    "express": "^4.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "jsdom": "^25.0.1",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
