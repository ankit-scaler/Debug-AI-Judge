{
  "name": "debugging-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:preview && next dev",
    "build": "npm run build:preview && next build",
    "start": "next start",
    "build:preview": "node scripts/build-preview-vendor.mjs",
    "test": "vitest run",
    "eval": "tsx evals/run.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "esbuild": "0.28.2",
    "esbuild-wasm": "0.28.2",
    "jsdom": "27.0.0",
    "monaco-editor": "0.57.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "22.13.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "5.7.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
